{
  "expo": {
    "name": "PennyRelief",
    "slug": "penny-relief",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pennyrelief",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pennyrelief.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#030960"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/LogoImg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/LogoImg.png",
          "resizeMode": "contain",
          "backgroundColor": "#030960"
        }
      ],
      [
        "expo-font"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}