# ==============================================================================
# NFC 100's Rupee Bank - Unified Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemma 4 Intelligence Configuration
# ------------------------------------------------------------------------------
# Provider Selection: "ollama" (default local) or "gemini" (cloud alternative)
LLM_PROVIDER=ollama

# Local Ollama endpoint (runs open-source gemma4:e4b)
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Required only if LLM_PROVIDER=gemini (runs gemma-4-26b-a4b-it via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Server & Database Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/nfc_bank
MONGODB_URI=mongodb://127.0.0.1:27017/nfc_bank
JWT_SECRET=nfc_bank_dev_secret_key_change_in_production_2026

# ------------------------------------------------------------------------------
# 3. Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Email Notifications (Nodemailer Gmail)
# ------------------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_google_app_password

# ------------------------------------------------------------------------------
# 5. Payment & Micro-Donations (Stripe)
# ------------------------------------------------------------------------------
STRIPE_TEST_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# ------------------------------------------------------------------------------
# 6. Frontend / Mobile Connection URL
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://192.168.10.9:5000
VITE_API_URL=http://localhost:5000
